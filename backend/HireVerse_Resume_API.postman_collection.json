{
  "info": {
    "name": "HireVerse — Resume Analyzer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token",   "value": "YOUR_JWT_TOKEN_HERE" },
    { "key": "userId",  "value": "YOUR_USER_ID_HERE" },
    { "key": "resumeId","value": "" }
  ],
  "item": [
    {
      "name": "1. Upload Resume (file only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "resume", "type": "file", "src": "/path/to/your-resume.pdf" }
          ]
        },
        "url": "{{baseUrl}}/resume/upload"
      }
    },
    {
      "name": "2. Analyze Resume (upload + analyze)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "resume", "type": "file", "src": "/path/to/your-resume.pdf" }
          ]
        },
        "url": "{{baseUrl}}/resume/analyze"
      }
    },
    {
      "name": "2b. Analyze Already-Uploaded Resume (by ID)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"resumeId\": \"{{resumeId}}\" }"
        },
        "url": "{{baseUrl}}/resume/analyze"
      }
    },
    {
      "name": "3. Get Resume History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw":   "{{baseUrl}}/resume/history/{{userId}}?page=1&limit=10",
          "query": [
            { "key": "page",  "value": "1" },
            { "key": "limit", "value": "10" }
          ],
          "path": ["resume","history","{{userId}}"]
        }
      }
    },
    {
      "name": "4. Get Latest Resume",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/resume/latest/{{userId}}"
      }
    },
    {
      "name": "5. Delete Resume",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/resume/{{resumeId}}"
      }
    }
  ]
}
