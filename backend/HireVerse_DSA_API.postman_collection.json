{
  "info": {
    "name": "HireVerse — DSA Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token",   "value": "YOUR_JWT_TOKEN_HERE" }
  ],
  "item": [
    {
      "name": "1. Update Progress (record solved problem)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topicName\": \"Dynamic Programming\",\n  \"count\": 1,\n  \"difficulty\": \"Medium\"\n}"
        },
        "url": "{{baseUrl}}/dsa/update-progress"
      }
    },
    {
      "name": "2. Get Dashboard",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/dsa/dashboard"
      }
    },
    {
      "name": "3. Get Topics",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/dsa/topics"
      }
    },
    {
      "name": "4. Get Heatmap (last 90 days)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw":   "{{baseUrl}}/dsa/heatmap?days=90",
          "query": [{ "key": "days", "value": "90" }],
          "path":  ["dsa", "heatmap"]
        }
      }
    },
    {
      "name": "5. Get Suggestions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/dsa/suggestions"
      }
    },
    {
      "name": "6. Add Problem (bookmark)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Word Break II\",\n  \"difficulty\": \"Hard\",\n  \"topic\": \"Dynamic Programming\",\n  \"leetcodeUrl\": \"https://leetcode.com/problems/word-break-ii/\"\n}"
        },
        "url": "{{baseUrl}}/dsa/add-problem"
      }
    },
    {
      "name": "7. Update Streak (manual)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"increment\"\n}"
        },
        "url": "{{baseUrl}}/dsa/update-streak"
      }
    }
  ]
}
